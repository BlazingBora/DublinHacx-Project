# Azure AI Foundry (OpenAI-compatible) credentials - used for OCR (vision),
# product/medication extraction, expiration estimates, and recipes.
AZURE_API_KEY=
AZURE_ENDPOINT=

# Postgres connection string. Required in production (e.g. Vercel, where
# the filesystem is ephemeral). Get one from Vercel Postgres, Neon, or
# Supabase. Left unset, the app falls back to a local SQLite file - fine
# for local dev, but won't work on Vercel.
DATABASE_URL=

# Used to sign Flask's session cookie. Any random string works; generate
# one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
